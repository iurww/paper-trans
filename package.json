{
  "name": "paperlens",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "dev:desktop": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "linux:dev": "tauri dev",
    "linux:build": "tauri build --bundles deb,appimage",
    "release:version": "node tools/release-version.mjs",
    "test": "node --test tests/*.test.js",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "mac:dev": "tauri dev",
    "mac:build": "tauri build --bundles dmg"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.5",
    "@capacitor/core": "^7.4.5",
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "@tauri-apps/plugin-http": "^2.8.2",
    "katex": "^0.19.0",
    "lucide-react": "^1.53.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.5",
