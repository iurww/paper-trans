# Keep the original Ubuntu 22.04 compatibility baseline. The NVIDIA fix is
# applied by the application before WebKit starts, not by replacing the distro.
ARG RUST_IMAGE=rust:1.99.0-slim-bookworm
FROM node:22.22.0-bookworm-slim AS node
FROM ${RUST_IMAGE} AS rust
RUN mkdir -p /toolchain \
    && if [ -d /usr/local/rustup ]; then \
      cp -a /usr/local/cargo /toolchain/cargo && cp -a /usr/local/rustup /toolchain/rustup; \
    else \
      cp -a /root/.cargo /toolchain/cargo && cp -a /root/.rustup /toolchain/rustup; \
    fi
FROM ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ARG APT_MIRROR
RUN if [ -n "$APT_MIRROR" ]; then sed -i -e "s|http://archive.ubuntu.com/ubuntu|$APT_MIRROR|g" -e "s|http://security.ubuntu.com/ubuntu|$APT_MIRROR|g" /etc/apt/sources.list; fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git xz-utils pkg-config \
    libwebkit2gtk-4.1-dev libgtk-3-dev libssl-dev librsvg2-dev \
    patchelf libfuse2 file xdg-utils python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY --from=rust /toolchain/cargo /root/.cargo
COPY --from=rust /toolchain/rustup /root/.rustup
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_HOME=/root/.cargo RUSTUP_HOME=/root/.rustup
ENV APPIMAGE_EXTRACT_AND_RUN=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb xauth dbus-x11 libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
