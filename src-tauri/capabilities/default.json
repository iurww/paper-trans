{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Linux main window: save user-selected exports and call configured translation APIs",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
