{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PaperLens",
  "version": "0.2.0",
  "identifier": "io.paperlens.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PaperLens",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Education",
    "shortDescription": "论文翻译与双语 PDF 阅读工作台",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
